{
  "name": "mailnest",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "description": "MailNest — self-hosted multi-account webmail",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node tests/imap-list.mjs && node tests/oauth-device.mjs && node tests/cache.mjs && node tests/attachments.mjs && node tests/frontend.mjs && node tests/range.mjs && node tests/draft.mjs && node tests/send.mjs && node tests/mcp.mjs",
    "test:imap": "node tests/imap-list.mjs",
    "test:oauth": "node tests/oauth-device.mjs",
    "test:cache": "node tests/cache.mjs && node tests/attachments.mjs",
    "test:range": "node tests/range.mjs",
    "test:ui": "node tests/frontend.mjs",
    "test:mcp": "node tests/mcp.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.19.2",
    "imapflow": "^1.0.164",
    "juice": "^12.2.3",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.14",
    "sanitize-html": "^2.13.1"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  }
}
